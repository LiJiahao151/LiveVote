rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /polls/{pollId}/votes/{voterId} {
      allow read: if pollId == "class-demo";

      allow create: if pollId == "class-demo"
        && request.auth != null
        && voterId == request.auth.uid
        && request.resource.data.keys().hasOnly(["candidate", "createdAt"])
        && request.resource.data.candidate in ["zhangsan", "lisi", "wangwu"]
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
