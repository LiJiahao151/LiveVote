rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function validCandidate(roleId, candidate) {
      return (roleId == "org" && candidate in ["huangchuanhao", "sunsiqi", "fengwenjiao", "miaoyoujia", "chensitong"])
        || (roleId == "life" && candidate in ["wangxinjun", "linpeng"])
        || (roleId == "tech" && candidate in ["yiru", "zhouhanfei", "tianhuijun", "houlong"])
        || (roleId == "discipline" && candidate in ["zoujingdan", "wangwenjun"]);
    }

    match /polls/{pollId}/roles/{roleId}/votes/{voterId} {
      allow read: if pollId == "class-election-2026"
        && roleId in ["org", "life", "tech", "discipline"];

      allow create: if pollId == "class-election-2026"
        && request.auth != null
        && voterId == request.auth.uid
        && request.resource.data.keys().hasOnly(["candidate", "createdAt"])
        && validCandidate(roleId, request.resource.data.candidate)
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
